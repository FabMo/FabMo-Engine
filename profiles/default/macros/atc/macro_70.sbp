$toolsUU[5][].Z := -7.135
$toolsUU[5][].H := -5
$toolsUU[6][].X := 100.823
$toolsUU[6][].Y := 28.7835
$toolsUU[6][].Z := -7.107
$toolsUU[6][].H := -5
$toolsUU[7][].X := 100.8335
$toolsUU[7][].Y := 33.4125
$toolsUU[7][].Z := -7.09
$toolsUU[7][].H := -5
$toolsUU[8][].X := 100.845
$toolsUU[8][].Y := 38.1025
$toolsUU[8][].Z := -7.091
$toolsUU[8][].H := -5
$toolsUU[9][].X := 100.843
$toolsUU[9][].Y := 42.7835
$toolsUU[9][].Z := -7.096
$toolsUU[9][].H := -5
$toolsUU[10][].X := 100.857
$toolsUU[10][].Y := 47.4435
$toolsUU[10][].Z := -7.111
$toolsUU[10][].H := -5
$toolsUU[11][].X := 100.861
$toolsUU[11][].Y := 52.129
$toolsUU[11][].Z := -7.09
$toolsUU[11][].H := -5
'Motion values
$zSlowUU[] = 0.4
$zFastUU[] = 0.75
