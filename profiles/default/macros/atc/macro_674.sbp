'!FABMO!name:ATC Calibration
'!FABMO!description:Toolbar Calibration for PRS5 ATC
'!FABMO!enabled:true
' ATC Calibration; records location of all the tool clips.
' Brian Owen

' Main =========================================================================
CN,75
&u = %(25) 
SO, $ToolBar,0																	' >> Tool Bar will lower if up.
C3																				' >> Home machine in XYZ first. 
VN,0																			' >> Turn off limit switches
SF,0																			' >> Turn off table limits
JS, $xyJogUU[&u], $zJogUU[&u]   																' >> Set Jog speeds
PAUSE "How many positions exist on your toolbar" &count							' >> Maybe user does not want to use all 7 positions...so give them a choice.
$ATC.numClips = &count															' >> Update ATC settings based on user selection	
$ATC.numClips = $ATC.numClips * 1
PAUSE "Insert an empty tool holder in the spindle (no collet or nut)... (M-0051)"
PAUSE "...Insert an empty tool holder upside down in the #1 clip (no collet or nut)... (M-0052)"

SO, $ToolBar,1 																	' >> Tool Bar will raise up.

SK "Move Tool Holder Over Upside Down Tool Holder"

PAUSE "Place one end of the calibration clip on the pull stud on tool holder in the spindle #1 and the other on the stud of Tool #1. Click OK when ready to proceed! (M-0055)"



'Check Z Zero Input
IF %($sb_zZeroCk) == 1 THEN GOSUB CONTACT_TRIGGERED_ERROR						' >> We're about to lower the empty tool holder to touch the inverted tool holder in the clip. If input 1 is already triggered then we have a problem
&check = %(3) - %(106)															' >> Calculate max Z travel for probe move
PZ, &check,  $xySlowUU[&u], $sb_zZeroNum 												' >> Try to touch tool holders together
'IF &Debug = 1 THEN PAUSE "Press OK"
'IF %(3) <= &check THEN MZ,%(3) + $smallBackOff									' >> If we didn't make contact -- let's back off just in case the problem was a lack of electical continuity and we've crashed
IF %(3) <= &check THEN GOSUB CONTACT_ERROR										' >> Exit on error

'Set Clip Height
&Z_clipbase = %(3) - $ATC_holderHeightUU[&u] + %(9)											' >> If we succeeded in making contact, we record the current position for use later
JZ, %(3) + $smallBackOffUU[&u]  														' >> Back off to break contact
'JY,%(2) + $ToolBar_Probe_Offset													' >> Shift over in the Y to prepare for user to insert tool holder with drill rod
&start_X = %(1)																	' >> Record X start position
&start_Y = %(2)																	' >> Record Y start position
&start_Z = %(3)																	' >> Record Z start position
&alignment_height = %(3) - $ATC_holderAlignmentHeightUU[&u] - $smallBackOffUU[&u]			' >> Calculate correct z position for plunge

'IF &Debug = 1 THEN PAUSE "Press OK"
'IF %(2) >= &check THEN MY,%(2) - $smallBackOff									' >> If we went too far without contact -- first back off in case we crashed
'IF %(2) >= &check THEN GOSUB CONTACT_ERROR										' >> Then exit on error.

JZ, %(3) + $safe_liftUU[&u] 															' >> Safe Lift in the Z for user to insert tool holder with drill rod
JY, %(2) - 2 * $holder_radiusUU[&u]													' >> Safe move in the Y for user to insert tool holder with drill rod

PAUSE "Insert a Drill rod into collet and tighten into spindle tool holder... (M-0056)"

PAUSE "Make sure grounding clip is on drill rod and calibration clip is on bottom of tool holder #1. (M-0057)"

PAUSE "Use the keypad to lower the stylus tip approx. 1/4in below the top edge of the tool holder in clip #1. Press ESC when finished with keypad. (M-0058)"

SK

&toolIdx = 1
&first = 1
NEXT_HOLDER:

GOSUB FIND_HOLDER

IF &first == 1 THEN GOSUB SET_STYLUS_OFFSET

'&center_X = (&center_X - $sb_homeOff_X * $unitMultiplier) / $unitMultiplier		' >> Convert variable values to inches for storage
'&center_Y = (&center_Y - $sb_homeOff_Y * $unitMultiplier) / $unitMultiplier		' >> Convert variable values to inches for storage
&thisZ = &Z_top_surface + &stylus_offset							

$toolsUU[&toolIdx][].X = &center_X + $sb_homeOffUU[&u].x + %(7)										' >> Record X location of clip based on current position
$toolsUU[&toolIdx][].Y = &center_Y + $sb_homeOffUU[&u].y + %(8)								' >> Record Y location of clip based on current position
$toolsUU[&toolIdx][].Z = &thisZ														' >> Record Z location of clip (always the same)
$toolsUU[&toolIdx][].H = -5															' >> Populate bit length
&toolIdx = &toolIdx + 1															' >> Increment tool index
IF &toolIdx > $ATC.numClips THEN GOTO FINISHED									' >> If we've done all the clips we planned to do -- head for the exit.

PAUSE "OK, we are ready to calibrate the next holder. Please move the grounding clip to the next pull stud. (M-0059)"


JY,%(2) + $ToolBar_Probe_OffsetUU[&u]													' >> Shift over in the Y to prepare for user to insert tool holder with drill rod

JZ, &start_Z

GOTO NEXT_HOLDER
 																		' >> Set up index that will be incremented while recording values for each tool
'TOOL_POS_LOOP:	

FINISHED:

 JZ, %(3) + $safe_liftUU[&u]
 
 JX, %(1) - ($holder_radiusUU[&u] * 4)
 
 PAUSE "The keypad will now open. Please center the drill rod in the Center of the pressure Sensitive Z Zero Plate. This will Set the location for the Tool length Measurements"

 SK "Please center the drill rod in the Center of the pressure Sensitive Z Zero Plate"


PAUSE "This will be the center of your Pressure Sensitive Z Zero Plate"
  

CONTINUE:

$atcUU[].zZero_X = %(1)									' >> Store X location of fixed Z Zero plate (always the same)
$atcUU[].zZero_Y = %(2)											' >> Store Y location of fixed Z Zero plate (always the same)
SO, $ToolBar,0																	' >> Tool Bar will lower
PAUSE "Calibration complete (M-0151)"											' >> Display success message
PAUSE "The Spindle will now lift up and Jog Home"								' >> Display message to notify user that the machine will jog home
JZ, %(3) + $safe_liftUU[&u]															' >> Safe Lift in the Z for to allow the machine to Jog Home
J2,0,0																			' >> Jog home
END

' Error Handling ===============================================================
CONTACT_TRIGGERED_ERROR:
PAUSE "Your Z Zero input is already triggered, if the z zero plate on your gantry is plugged in, please unplug and press OK."
END
RETURN

CONTACT_ERROR:
PAUSE "Unable to make contact with tool holder, check that grounding cable is connecting pull stud to fixed z zero plate."
END
RETURN

SET_STYLUS_OFFSET:
    &stylus_offset = &Z_clipbase - &Z_top_surface
	&first = 0
return

FIND_HOLDER:
    
    &start_X = %(1)
    &start_Y = %(2)
    &start_Z = %(3)
	
    &target_ck = %(2) + $nextYUU[&u]
    PY,%(2) + $nextYUU[&u],  $sb_SlowSearchSpeedUU[&u].xy, $sb_zZeroNum
	IF %(2) == &target_ck THEN GOTO FAILED_EXIT

  FOUND_EDGE:
    &yEdge = %(2)

    JY, &yEdge - $thClearanceUU[&u]
    JZ, %(3) + $safe_liftUU[&u]
	MY, &yEdge + $stylus_diaUU[&u]
	'Then find the Holder height   
    if %(51) = 1 then GoTo CLOSED_EXIT
    &target_ck = %(3) - $safe_liftUU[&u]
      PZ, (-1 * $safe_liftUU[&u]), $sb_SlowSearchSpeedUU[&u].z, $sb_zZeroNum
      IF %(3) == &target_ck THEN GOTO FAILED_EXIT

  TOPZ:
    &Z_top_surface = %(3)
    MZ, %(3) + $thClearanceUU[&u]
	
    JY, &yEdge + $holder_radiusUU[&u] + ($stylus_diaUU[&u]/2)
	&start_Y = %(2)
	MZ, %(3) - 2 * $thClearanceUU[&u]
   
	GoSub CENTER_IN_XY

    ' lift to clear lip and then move to position for next holder
    MZ, %(3) + $safe_liftUU[&u]
    MY, %(2) + ($holder_radiusUU[&u] * 2)
	MZ, &Z_top_surface - $thClearanceUU[&u]
	&nextHolderY = %(2) + $nextYUU[&u]

  return

CENTER_IN_XY:
    'Set up Speeds, etc
    
    'Move left and right to get end points of a chord; X center-point is at 1/2 this distance
    if %(51) = 1 then GoTo CLOSED_EXIT
    
    &target_ck = %(1) - $holder_radiusUU[&u] * 1.5
    PX,(%(1) - 1.5 * $holder_radiusUU[&u]), $sb_SlowSearchSpeedUU[&u].xy, $sb_zZeroNum
    IF %(1) == &target_ck THEN GOTO FAILED_EXIT

    HIT_LEFT:
      &leftstart = %(1)
      MX, &start_X
    if %(51) = 1 then GoTo CLOSED_EXIT
    &target_ck = %(1) + $holder_radiusUU[&u] * 1.5
    PX,(%(1) + 1.5 * $holder_radiusUU[&u]), $sb_SlowSearchSpeedUU[&u].xy, $sb_zZeroNum
    IF %(1) == &target_ck THEN GOTO FAILED_EXIT

	HIT_RIGHT:
      &rightstart = %(1)
      &center_X = &leftstart + ((&rightstart - &leftstart) / 2)
      MX, &center_X

    'Move up and down to get end points of another chord; Y center-point is at 1/2 this distance
    if %(51) = 1 then GoTo CLOSED_EXIT
    &target_ck = %(2) - $holder_radiusUU[&u] * 1.5
    PY,(%(2) - 1.5 * $holder_radiusUU[&u]), $sb_SlowSearchSpeedUU[&u].xy, $sb_zZeroNum
	IF %(2) == &target_ck THEN GOTO FAILED_EXIT

    HIT_BOTTOM:
      &bottomstart = %(2)
      MY, &start_Y
    if %(51) = 1 then GoTo CLOSED_EXIT
    &target_ck = %(2) + $holder_radiusUU[&u] * 1.5
    PY,(%(2) + 1.5 * $holder_radiusUU[&u]), $sb_SlowSearchSpeedUU[&u].xy, $sb_zZeroNum
    IF %(2) == &target_ck THEN GOTO FAILED_EXIT

    HIT_TOP:
      &topstart = %(2)
      &center_Y = &bottomstart + ((&topstart - &bottomstart) / 2)
      MY, &center_Y
	  

    'Move left and right to get end points of a chord; X center-point is at 1/2 this distance
    if %(51) = 1 then GoTo CLOSED_EXIT
    &target_ck = %(1) - $holder_radiusUU[&u] * 1.5
    PX,(%(1) - 1.5 * $holder_radiusUU[&u]), $sb_SlowSearchSpeedUU[&u].xy, $sb_zZeroNum
    IF %(1) == &target_ck THEN GOTO FAILED_EXIT

    HIT_LEFT2:
      &leftstart = %(1)
      MX, &start_X
    if %(51) = 1 then GoTo CLOSED_EXIT
    &target_ck = %(1) + $holder_radiusUU[&u] * 1.5
    PX,(%(1) + 1.5 * $holder_radiusUU[&u]), $sb_SlowSearchSpeedUU[&u].xy, $sb_zZeroNum
    IF %(1) == &target_ck THEN GOTO FAILED_EXIT
    
    HIT_RIGHT2:
      &rightstart = %(1)
      &center_X = &leftstart + ((&rightstart - &leftstart) / 2)
      MX, &center_X
	&start_X = &center_X

	'VS, &startspeed_XY, &startspeed_Z     REM BY GC 
  return
  
FAILED_EXIT:
closed_exit:
JZ, %(3) + $safe_liftUU[&u]
END
