[Unit]
Description=3D scanner daemon (scand.py, port 3150) for the 3D Scanner dashboard app
After=network.target fabmo.service
Wants=fabmo.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/dev/fabmo-scanner/scanner
ExecStart=/usr/bin/python3 -u /home/pi/dev/fabmo-scanner/scanner/scand.py --port 3150
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
